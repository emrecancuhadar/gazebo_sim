<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="demo">

    <!-- ─── Core Systems ─────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="BasicSystem"
            name="ros_gz_example_gazebo::BasicSystem"/>
    <plugin filename="FullSystem"
            name="ros_gz_example_gazebo::FullSystem"/>

    <!-- ─── Sun Light ───────────────────────────────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ─── Robot #1: diff_drive ─────────────────────────────────── -->
    <model name="diff_drive">
      <self_collide>true</self_collide>
      <pose>0 0 0.35 0 0 0</pose>

      <include merge="true">
        <uri>package://ros_gz_example_description/models/diff_drive</uri>
      </include>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher"/>
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>1</static_update_frequency>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>diff_drive/odom</odom_frame>
        <robot_base_frame>diff_drive</robot_base_frame>
        <odom_publish_frequency>100</odom_publish_frequency>
      </plugin>
    </model>

    <!-- ─── Robot #2: diff_drive2 ────────────────────────────────── -->
    <model name="diff_drive2">
      <self_collide>true</self_collide>
      <pose>10 0 0.35 0 0 0</pose>

      <include merge="true">
        <uri>package://ros_gz_example_description/models/diff_drive_red</uri>
      </include>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher"/>
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>1</static_update_frequency>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>diff_drive2/odom</odom_frame>
        <robot_base_frame>diff_drive2</robot_base_frame>
        <odom_publish_frequency>100</odom_publish_frequency>
      </plugin>
    </model>

    <model name="diff_drive3">
      <self_collide>true</self_collide>
      <pose>-10 0 0.35 0 0 0</pose>

      <include merge="true">
        <uri>package://ros_gz_example_description/models/diff_drive_blue</uri>
      </include>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher"/>
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>1</static_update_frequency>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>diff_drive3/odom</odom_frame>
        <robot_base_frame>diff_drive3</robot_base_frame>
        <odom_publish_frequency>100</odom_publish_frequency>
      </plugin>
    </model>

    <!-- ─── Ground Plane ─────────────────────────────────────────── -->
    <include>
      <uri>package://ros_gz_example_description/models/my_ground_plane</uri>
    </include>

  </world>
</sdf>
